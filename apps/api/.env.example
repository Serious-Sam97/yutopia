APP_NAME=Yutopia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@yutopia.test"
MAIL_FROM_NAME="${APP_NAME}"

# Local dev: APP_ENV=local, APP_DEBUG=true, YUTOPIA_DEMO=1 (the demo people).
# Yutopia (see config/yutopia.php). The secrets, the public URLs and the LiveKit keys
# are shared with the world-server; on the Docker stack they come from yutopia/.env
# (which wins over this file).
# seed ana@ / bia@yutopia.test (a known password): local dev only
YUTOPIA_DEMO=false
YUTOPIA_WORLD_NAME=Yutopia
YUTOPIA_WORLD_SECRET=
YUTOPIA_INTERNAL_SECRET=
YUTOPIA_WORLD_URL=ws://localhost:2567
# how the API reaches the world-server for live phone events (POST /internal/push)
YUTOPIA_WORLD_INTERNAL=http://localhost:2567
YUTOPIA_CLIENT_URL=http://localhost:3100
# open | invite | closed
YUTOPIA_SIGNUP=invite
# comma-separated emails that become admins when they sign in
YUTOPIA_ADMINS=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# discs the world keeps (bytes, default 10 GiB); never set the test BIOS in production
YUTOPIA_DISC_QUOTA=
YUTOPIA_TEST_BIOS_MD5=
# the e2e suite may put the world back to its fixtures: local / test stacks only, never production
YUTOPIA_E2E=false
# Vortex says heck, not hell
YUTOPIA_POLITE=false
# shared with VortexOS's backend ("sign in with Yutopia" on the computers)
VORTEXOS_SHARED_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# where games, discs, saves, BIOS and photos live (default storage/app/private)
# YUTOPIA_FILES=/data/files

# Yondra's database, for `php artisan yutopia:import` only (the one-off move; a
# read-only role is enough). Remove once the import is done.
# YONDRA_DB_CONNECTION=pgsql
# YONDRA_DB_HOST=pgsql
# YONDRA_DB_PORT=5432
# YONDRA_DB_DATABASE=laravel
# YONDRA_DB_USERNAME=yutopia_import
# YONDRA_DB_PASSWORD=
