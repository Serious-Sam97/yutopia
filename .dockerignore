# build context for the client and world-server images (docker/prod/compose.yaml);
# the API builds from apps/api with its own .dockerignore
.git
**/node_modules
**/.next
**/.next-*
**/dist
# (but Jolt's own build: the one jolt-physics there is — packages/jolt)
!packages/jolt/dist
**/test-results
**/playwright-report
**/*.log
**/.env
**/.env.*
!**/.env.example
apps/api
docker
design
docs
apps/client/public/emu/cores
apps/client/public/emu/games
# what's on a working copy but not in git (the client's build makes the decoders itself; the
# photo-skinned people the game never loads): an image from here the same as one from a clean checkout
apps/client/public/decoders
apps/client/public/life/person-man.glb
apps/client/public/life/person-woman.glb
